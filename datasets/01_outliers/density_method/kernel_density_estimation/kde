        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import gaussian_kde\n",
        "\n",
        "# Sample data\n",
        "data = np.array([1, 2, 2, 3, 4, 5, 5, 6, 10])\n",
        "\n",
        "# KDE model\n",
        "#kde = gaussian_kde(data)\n",
        "kde = gaussian_kde(data, best_bw)\n",
        "\n",
        "# Points to evaluate density\n",
        "x_vals = np.linspace(0, 12, 50)\n",
        "\n",
        "# Density values\n",
        "density = kde(x_vals)\n",
        "\n",
        "# Plot\n",
        "plt.plot(x_vals, density)\n",
        "plt.scatter(data, np.zeros_like(data), marker='x')\n",
        "\n",
        "plt.title(\"Kernel Density Estimation\")\n",
        "plt.xlabel(\"Value\")\n",
        "plt.ylabel(\"Density\")\n",
        "\n",
        "plt.show()"
      ]
