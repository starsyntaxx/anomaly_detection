    },
    {
      "cell_type": "code",
      "source": [
        "bandwidths = np.linspace(0.1, 2, 20)\n",
        "\n",
        "best_bw = max(bandwidths, key=lambda b: score_bandwidth(data, b))\n",
        "\n"
      ],
